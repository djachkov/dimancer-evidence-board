{
  "id": "dimancer_board",
  "title": "Dimancer's Evidence Board",
  "description": "Turn a Scene into a collaborative investigation board: pin images as evidence, move and resize them together with your players, and keep every piece (images and text documents) in a shared Evidence Journal with notes.",
  "version": "0.1.0",
  "authors": [{ "name": "Dmitrii Diachkov", "url": "https://github.com/djachkov" }],
  "compatibility": {
    "minimum": "14",
    "verified": "14.370"
  },
  "esmodules": ["scripts/main.mjs"],
  "styles": ["styles/dimancer-board.css"],
  "languages": [
    { "lang": "en", "name": "English", "path": "lang/en.json" }
  ],
  "documentTypes": {
    "JournalEntryPage": {
      "evidence": { "htmlFields": ["notes"] }
    }
  },
  "socket": true,
  "url": "https://github.com/djachkov/foundryvtt-dimancer-board",
  "manifest": "https://github.com/djachkov/foundryvtt-dimancer-board/releases/latest/download/module.json",
  "download": "https://github.com/djachkov/foundryvtt-dimancer-board/releases/latest/download/module.zip",
  "readme": "https://github.com/djachkov/foundryvtt-dimancer-board/blob/main/README.md",
  "bugs": "https://github.com/djachkov/foundryvtt-dimancer-board/issues"
}
