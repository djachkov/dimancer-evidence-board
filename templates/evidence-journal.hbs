<div class="mb-book{{#if reading}} is-reading{{else}} is-contents{{/if}}" data-style="{{style}}" style="{{styleVars}}">

  {{!-- The bar over the book: finding and adding in the contents, paging while reading. --}}
  <header class="mb-book-bar">
    {{#if reading}}
    <button type="button" class="mb-bar-button" data-action="contents" data-tooltip="DIMANCER_BOARD.Journal.ContentsHint">
      <i class="fa-solid fa-chevron-left" inert></i><span>{{localize "DIMANCER_BOARD.Journal.Contents"}}</span>
    </button>
    <nav class="mb-turn" aria-label="{{localize "DIMANCER_BOARD.Journal.Contents"}}">
      <button type="button" class="mb-bar-icon" data-action="prev" data-tooltip="DIMANCER_BOARD.Journal.Prev"
              aria-label="{{localize "DIMANCER_BOARD.Journal.Prev"}}"{{#unless turn.prev}} disabled{{/unless}}><i class="fa-solid fa-arrow-left" inert></i></button>
      <span class="mb-turn-count">{{localize "DIMANCER_BOARD.Journal.PageNumber" n=turn.number total=turn.total}}</span>
      <button type="button" class="mb-bar-icon" data-action="next" data-tooltip="DIMANCER_BOARD.Journal.Next"
              aria-label="{{localize "DIMANCER_BOARD.Journal.Next"}}"{{#unless turn.next}} disabled{{/unless}}><i class="fa-solid fa-arrow-right" inert></i></button>
    </nav>
    {{else}}
    <button type="button" class="mb-bar-button mb-journal-switch" data-action="journals" data-tooltip="DIMANCER_BOARD.Journal.SwitchHint">
      <i class="fa-solid {{#if isDefault}}fa-star is-default{{else}}fa-book{{/if}}" inert></i><span>{{title}}</span><i class="fa-solid fa-caret-down" inert></i>
    </button>
    <div class="mb-search">
      <i class="fa-solid fa-magnifying-glass" inert></i>
      <input type="search" name="search" value="{{query}}" placeholder="{{localize "DIMANCER_BOARD.Journal.SearchHint"}}"
             aria-label="{{localize "DIMANCER_BOARD.List.Search"}}" autocomplete="off">
      <button type="button" class="mb-bar-icon" data-action="clearSearch" hidden
              aria-label="{{localize "DIMANCER_BOARD.List.Clear"}}"><i class="fa-solid fa-xmark" inert></i></button>
    </div>
    <button type="button" class="mb-bar-button{{#if filtered}} is-on{{/if}}" data-action="filter" data-tooltip="DIMANCER_BOARD.Journal.FilterHint">
      <i class="fa-solid fa-sliders" inert></i><span>{{localize "DIMANCER_BOARD.Journal.Filter"}}</span>
    </button>
    {{#if editable}}
    <button type="button" class="mb-bar-button is-primary" data-action="addMenu" data-tooltip="DIMANCER_BOARD.Journal.AddMenuHint">
      <i class="fa-solid fa-plus" inert></i><span>{{localize "DIMANCER_BOARD.Journal.AddMenu"}}</span>
    </button>
    {{/if}}
    {{/if}}
    <span class="mb-bar-spacer"></span>
    <button type="button" class="mb-bar-button" data-action="openBoard"{{#unless boards.length}} disabled{{/unless}}
            data-tooltip="{{#if boards.length}}DIMANCER_BOARD.Journal.OpenBoardHint{{else}}DIMANCER_BOARD.Journal.NoBoards{{/if}}">
      <i class="fa-solid fa-chalkboard" inert></i>
      <span>{{#if (eq boards.length 1)}}{{boards.0.name}}{{else}}{{localize "DIMANCER_BOARD.Journal.OpenBoard"}}{{/if}}</span>
      {{#if (gt boards.length 1)}}<i class="fa-solid fa-caret-down" inert></i>{{/if}}
    </button>
    {{#if reading}}
    <button type="button" class="mb-bar-icon" data-action="itemMenu" data-tooltip="DIMANCER_BOARD.Journal.More"
            aria-label="{{localize "DIMANCER_BOARD.Journal.More"}}"><i class="fa-solid fa-ellipsis" inert></i></button>
    {{/if}}
  </header>

  <div class="mb-spread">
  {{#if reading}}
  {{#with selected}}

    {{!-- Left page: the evidence itself, large. --}}
    <section class="mb-page mb-page-left mb-exhibit">
      {{#if isPhoto}}
      <figure class="mb-card is-{{card.style}} mb-card-photo mb-card-large" style="--accent: {{card.accent}};{{#if card.clip}} --clip: {{card.clip}};{{/if}}">
        <div class="mb-card-paper">
          <div class="mb-card-face">
            <section class="mb-stage mb-card-photo-stage" data-stage data-tooltip="DIMANCER_BOARD.Journal.ZoomHint" data-tooltip-direction="UP">
              {{#if src}}<img src="{{src}}" alt="{{title}}" draggable="false">{{/if}}
              <p class="mb-broken">{{localize "DIMANCER_BOARD.Viewer.Broken"}}</p>
              <div class="mb-zoom">
                <button type="button" data-action="zoomOut" aria-label="{{localize "DIMANCER_BOARD.Viewer.ZoomOut"}}"><i class="fa-solid fa-minus" inert></i></button>
                <span class="mb-zoom-label" data-zoom-label>100%</span>
                <button type="button" data-action="zoomIn" aria-label="{{localize "DIMANCER_BOARD.Viewer.ZoomIn"}}"><i class="fa-solid fa-plus" inert></i></button>
                <button type="button" data-action="fit" data-tooltip="DIMANCER_BOARD.Viewer.Fit" aria-label="{{localize "DIMANCER_BOARD.Viewer.Fit"}}"><i class="fa-solid fa-expand" inert></i></button>
                <button type="button" data-action="actual" data-tooltip="DIMANCER_BOARD.Viewer.Actual" aria-label="{{localize "DIMANCER_BOARD.Viewer.Actual"}}">1:1</button>
                <button type="button" data-action="openImage" data-tooltip="DIMANCER_BOARD.Journal.PopOut" aria-label="{{localize "DIMANCER_BOARD.Journal.PopOut"}}"><i class="fa-solid fa-up-right-from-square" inert></i></button>
              </div>
            </section>
            <figcaption class="mb-card-title">{{card.title}}</figcaption>
          </div>
        </div>
      </figure>

      {{else if isPdf}}
      <figure class="mb-card is-{{card.style}} mb-card-pdf mb-card-large" style="--accent: {{card.accent}};{{#if card.clip}} --clip: {{card.clip}};{{/if}}">
        <div class="mb-card-paper">
          <div class="mb-card-face">
            <section class="mb-stage mb-card-photo-stage{{#if pdfBroken}} broken{{/if}}" data-stage>
              {{#if pdfPreview}}<img src="{{pdfPreview}}" alt="{{title}}" draggable="false">{{/if}}
              <p class="mb-broken">{{localize "DIMANCER_BOARD.Document.PdfBroken"}}</p>
              <div class="mb-zoom">
                <button type="button" data-action="zoomOut" aria-label="{{localize "DIMANCER_BOARD.Viewer.ZoomOut"}}"><i class="fa-solid fa-minus" inert></i></button>
                <span class="mb-zoom-label" data-zoom-label>100%</span>
                <button type="button" data-action="zoomIn" aria-label="{{localize "DIMANCER_BOARD.Viewer.ZoomIn"}}"><i class="fa-solid fa-plus" inert></i></button>
                <button type="button" data-action="fit" data-tooltip="DIMANCER_BOARD.Viewer.Fit" aria-label="{{localize "DIMANCER_BOARD.Viewer.Fit"}}"><i class="fa-solid fa-expand" inert></i></button>
              </div>
            </section>
          </div>
        </div>
      </figure>
      <button type="button" class="mb-read-pdf" data-action="openImage">
        <i class="fa-solid fa-book-open-reader" inert></i>
        {{#if pdfPages}}{{localize "DIMANCER_BOARD.Journal.ReadPdfPages" count=pdfPages}}{{else}}{{localize "DIMANCER_BOARD.Journal.ReadPdf"}}{{/if}}
      </button>

      {{else if isDocument}}
      <figure class="mb-card is-{{card.style}} mb-card-document mb-card-large{{#if (gt docPageCount 1)}} is-stacked{{/if}}"
              style="--accent: {{card.accent}}; --seal: {{card.seal}};{{#if card.clip}} --clip: {{card.clip}};{{/if}}">
        {{#if (gt docPageCount 1)}}<span class="mb-card-under mb-card-under-2" aria-hidden="true"></span><span class="mb-card-under mb-card-under-1" aria-hidden="true"></span>{{/if}}
        <div class="mb-card-paper">
          <div class="mb-card-face mb-doc-sheet">
            <h4 class="mb-card-doc-title">{{card.title}}</h4>
            {{#if editable}}
            <prose-mirror name="docPage" class="mb-prose" data-mb-editor data-document-uuid="{{uuid}}"
                          data-placeholder="{{localize "DIMANCER_BOARD.Document.Write"}}" value="{{docPageRaw}}"></prose-mirror>
            {{else if docPageEmpty}}
            <p class="mb-empty">{{localize "DIMANCER_BOARD.Document.Blank"}}</p>
            {{else}}
            <div class="mb-prose">{{{docPageHTML}}}</div>
            {{/if}}
          </div>
        </div>
        {{#if (gt docPageCount 1)}}<span class="mb-card-clip" aria-hidden="true"></span>{{/if}}
      </figure>
      <nav class="mb-doc-pager">
        <button type="button" class="mb-bar-icon" data-action="prevDocPage" aria-label="{{localize "DIMANCER_BOARD.Document.Prev"}}"
                data-tooltip="DIMANCER_BOARD.Document.Prev"{{#if isFirstDocPage}} disabled{{/if}}><i class="fa-solid fa-chevron-left" inert></i></button>
        <span class="mb-doc-count">{{localize "DIMANCER_BOARD.Document.PageOf" n=docPage total=docPageCount}}</span>
        <button type="button" class="mb-bar-icon" data-action="nextDocPage" aria-label="{{localize "DIMANCER_BOARD.Document.Next"}}"
                data-tooltip="DIMANCER_BOARD.Document.Next"{{#if isLastDocPage}} disabled{{/if}}><i class="fa-solid fa-chevron-right" inert></i></button>
        {{#if editable}}
        <button type="button" class="mb-bar-icon" data-action="addDocPage" aria-label="{{localize "DIMANCER_BOARD.Document.AddPage"}}"
                data-tooltip="DIMANCER_BOARD.Document.AddPage"><i class="fa-solid fa-file-circle-plus" inert></i></button>
        {{#if (gt docPageCount 1)}}
        <button type="button" class="mb-bar-icon" data-action="removeDocPage" aria-label="{{localize "DIMANCER_BOARD.Document.RemovePage"}}"
                data-tooltip="DIMANCER_BOARD.Document.RemovePage"><i class="fa-solid fa-file-circle-minus" inert></i></button>
        {{/if}}
        {{/if}}
      </nav>
      {{/if}}
    </section>

    {{!-- Right page: what we know about it. --}}
    <section class="mb-page mb-page-right mb-reading">
      <header class="mb-reading-head">
        {{#if editable}}
        <textarea class="mb-reading-title" name="title" rows="1" spellcheck="true"
                  placeholder="{{localize "DIMANCER_BOARD.Card.TitlePlaceholder"}}"
                  aria-label="{{localize "DIMANCER_BOARD.Card.Title"}}">{{title}}</textarea>
        {{else}}
        <h1 class="mb-reading-title{{#if untitled}} untitled{{/if}}">{{card.title}}</h1>
        {{/if}}
        <div class="mb-reading-meta">
          {{#if editable}}
          <button type="button" class="mb-chip{{#unless category}} is-empty{{/unless}}" data-action="pickCategory"
                  {{#if category}}style="--swatch: {{category.color}}"{{/if}} data-tooltip="DIMANCER_BOARD.Journal.SetCategory">
            <i class="fa-solid {{#if category}}{{category.icon}}{{else}}fa-tag{{/if}}" inert></i>
            {{#if category}}{{category.name}}{{else}}{{localize "DIMANCER_BOARD.Journal.NoCategory"}}{{/if}}
          </button>
          {{else if category}}
          <span class="mb-chip" style="--swatch: {{category.color}}"><i class="fa-solid {{category.icon}}" inert></i> {{category.name}}</span>
          {{/if}}
          {{#if @root.gm}}
          <button type="button" class="mb-chip mb-access{{#if hidden}} is-hidden{{/if}}" data-action="toggleHidden" aria-pressed="{{hidden}}"
                  data-tooltip="{{#if hidden}}DIMANCER_BOARD.Journal.Reveal{{else}}DIMANCER_BOARD.Journal.Hide{{/if}}">
            <i class="fa-solid {{#if hidden}}fa-eye-slash{{else}}fa-eye{{/if}}" inert></i>
            {{#if hidden}}{{localize "DIMANCER_BOARD.Journal.HiddenState"}}{{else}}{{localize "DIMANCER_BOARD.Journal.RevealedState"}}{{/if}}
          </button>
          {{else if hidden}}
          <span class="mb-chip mb-access is-hidden"><i class="fa-solid fa-eye-slash" inert></i> {{localize "DIMANCER_BOARD.Journal.HiddenState"}}</span>
          {{/if}}
        </div>
      </header>

      <article class="mb-reading-notes">
        {{#if editable}}
        <prose-mirror name="notes" class="mb-prose" data-mb-editor data-document-uuid="{{uuid}}"
                      data-placeholder="{{localize "DIMANCER_BOARD.Journal.NotesPlaceholder"}}" value="{{notes}}"></prose-mirror>
        {{else if hasNotes}}
        <div class="mb-prose">{{{notesHTML}}}</div>
        {{else}}
        <p class="mb-empty">{{localize "DIMANCER_BOARD.Journal.NoNotes"}}</p>
        {{/if}}
      </article>

      <footer class="mb-reading-foot">
        <p class="mb-reading-boards">
          <i class="fa-solid fa-thumbtack" inert></i>
          {{#if placements.length}}
          <span>{{localize "DIMANCER_BOARD.Journal.OnBoardsShort"}}</span>
          {{#each placements}}<button type="button" class="mb-link{{#if current}} current{{/if}}" data-action="jump" data-scene-id="{{sceneId}}" data-card-id="{{cardId}}"
            data-tooltip="{{localize "DIMANCER_BOARD.Journal.JumpTo" name=sceneName}}">{{sceneName}}</button>{{/each}}
          {{else}}
          <span>{{localize "DIMANCER_BOARD.Journal.NotPlaced"}}</span>
          {{/if}}
          {{#if canPlace}}<button type="button" class="mb-link" data-action="place">{{localize "DIMANCER_BOARD.Journal.PlaceOn" name=boardName}}</button>{{/if}}
        </p>
        <p class="mb-reading-byline">
          {{#if link}}<button type="button" class="mb-link" data-action="openLink" data-uuid="{{link.uuid}}"><i class="fa-solid fa-link" inert></i> {{link.name}}</button>{{/if}}
          {{#if author}}<span>{{localize "DIMANCER_BOARD.Journal.AddedBy" name=author}}</span>{{/if}}
          {{#if editable}}<span class="mb-save-state" data-saving="{{localize "DIMANCER_BOARD.Journal.Saving"}}" data-saved="{{localize "DIMANCER_BOARD.Journal.Saved"}}"></span>{{/if}}
        </p>
      </footer>
    </section>

  {{/with}}
  {{else}}

    {{!-- Left page: the table of contents. --}}
    <section class="mb-page mb-page-left mb-toc">
      <h2 class="mb-page-title">{{title}}</h2>
      <nav class="mb-modes" aria-label="{{localize "DIMANCER_BOARD.List.View"}}">
        {{#each modes}}<button type="button" data-action="mode" data-mode="{{id}}" aria-pressed="{{active}}"{{#if active}} class="active"{{/if}}>{{label}}</button>{{/each}}
      </nav>
      <ol class="mb-toc-list">
        {{#each toc}}
        <li class="mb-toc-entry{{#if loose}} is-loose{{/if}}" data-section="{{key}}"{{#if kind}} data-kind="{{kind}}" data-group-id="{{groupId}}"{{/if}}
            data-ancestors="{{#each ancestors}}{{this}} {{/each}}" style="--depth: {{depth}};{{#if color}} --group-color: {{color}};{{/if}}"
            {{#if draggable}}draggable="true"{{/if}}>
          {{#if kind}}<button type="button" class="mb-toc-caret" data-action="toggle" aria-label="{{name}}"><i class="fa-solid fa-chevron-down" inert></i></button>
          {{else}}<span class="mb-toc-caret"></span>{{/if}}
          <a class="mb-toc-name" data-action="goto">
            <i class="fa-solid {{icon}} fa-fw{{#if (eq kind "folder")}} mb-folder-icon{{/if}}" inert></i>
            <span>{{name}}</span>
          </a>
          <span class="mb-toc-leader" aria-hidden="true"></span>
          <span class="mb-toc-count">{{count}}</span>
          {{#if menu}}<button type="button" class="mb-toc-menu" data-action="groupMenu" aria-label="{{localize "DIMANCER_BOARD.Folder.Menu"}}"><i class="fa-solid fa-ellipsis" inert></i></button>{{/if}}
        </li>
        {{/each}}
      </ol>
      {{#if editable}}
      <div class="mb-toc-tools">
        {{#if isFolders}}<button type="button" class="mb-link" data-action="newFolder"><i class="fa-solid fa-folder-plus" inert></i> {{localize "DIMANCER_BOARD.Folder.Create"}}</button>{{/if}}
        {{#if isCategories}}<button type="button" class="mb-link" data-action="manageCategories"><i class="fa-solid fa-gear" inert></i> {{localize "DIMANCER_BOARD.Category.Manage"}}</button>{{/if}}
      </div>
      {{/if}}
      {{#if isDefault}}
      <p class="mb-default-note" data-tooltip="DIMANCER_BOARD.Journal.DefaultHint"><i class="fa-solid fa-star" inert></i> {{localize "DIMANCER_BOARD.Journal.IsDefault"}}</p>
      {{else if editable}}
      <p class="mb-default-note"><button type="button" class="mb-link" data-action="makeDefault" data-tooltip="DIMANCER_BOARD.Journal.DefaultHint"><i class="fa-regular fa-star" inert></i> {{localize "DIMANCER_BOARD.Journal.MakeDefault"}}</button></p>
      {{/if}}
      <footer class="mb-page-foot">{{countLabel}}</footer>
    </section>

    {{!-- Right page: the contact sheet. --}}
    <section class="mb-page mb-page-right mb-sheet">
      {{#if empty}}
      <p class="mb-sheet-empty">{{localize "DIMANCER_BOARD.Journal.Empty"}}</p>
      {{else}}
      {{#each sections}}
      <section class="mb-section" data-section="{{key}}"{{#if kind}} data-kind="{{kind}}" data-group-id="{{groupId}}"{{/if}}
               data-ancestors="{{#each ancestors}}{{this}} {{/each}}" style="--depth: {{depth}};{{#if color}} --group-color: {{color}};{{/if}}">
        <h3 class="mb-section-title">
          {{#if kind}}<button type="button" class="mb-toc-caret" data-action="toggle" aria-label="{{name}}"><i class="fa-solid fa-chevron-down" inert></i></button>{{/if}}
          <i class="fa-solid {{icon}} fa-fw{{#if (eq kind "folder")}} mb-folder-icon{{/if}}" inert></i>
          <span>{{name}}</span>
          <small>{{count}}</small>
        </h3>
        {{#if cards.length}}
        <ol class="mb-cards">
          {{#each cards}}
          <li class="mb-cell" data-card-id="{{id}}" data-search="{{search}}" draggable="true" data-action="open"
              data-tooltip="DIMANCER_BOARD.Journal.CardHint" data-tooltip-direction="DOWN">
            {{> "modules/dimancer_board/templates/journal-card.hbs" card}}
            <span class="mb-cell-marks">
              {{#if card.placed}}<span data-tooltip="DIMANCER_BOARD.Journal.OnBoardsHint"><i class="fa-solid fa-thumbtack" inert></i>{{#if (gt card.placed 1)}} {{card.placed}}{{/if}}</span>{{/if}}
              {{#if card.hidden}}<span data-tooltip="DIMANCER_BOARD.Journal.HiddenHint"><i class="fa-solid fa-eye-slash" inert></i></span>{{/if}}
            </span>
          </li>
          {{/each}}
        </ol>
        {{else}}
        <p class="mb-section-empty">{{localize "DIMANCER_BOARD.Journal.EmptySection"}}</p>
        {{/if}}
      </section>
      {{/each}}
      <p class="mb-sheet-empty mb-nomatch" hidden>{{localize "DIMANCER_BOARD.List.NoMatch"}}</p>
      {{/if}}
    </section>

  {{/if}}
  </div>
</div>
